generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id               String        @id @default(cuid()) @db.VarChar(25)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")
  cognitoUserId    String        @unique @map("cognito_user_id") @db.VarChar(36)
  stripeCustomerId String?       @unique @map("stripe_customer_id") @db.VarChar(255)
  projects         Project[]
  subscription     Subscription?

  @@map("users")
}

model Subscription {
  id                   String   @id @default(cuid()) @db.VarChar(25)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  userId               String   @unique @map("user_id") @db.VarChar(25)
  user                 User     @relation(fields: [userId], references: [id])
  stripeSubscriptionId String   @unique @map("stripe_subscription_id") @db.VarChar(255)
  // "active" | "canceled" | "past_due" | "unpaid" | "trialing" など
  status               String   @db.VarChar(50)
  currentPeriodStart   DateTime @map("current_period_start")
  currentPeriodEnd     DateTime @map("current_period_end")
  // 現在の契約期間の終了時に解約される予定かどうか
  cancelAtPeriodEnd    Boolean  @default(false) @map("cancel_at_period_end")

  @@map("subscriptions")
}

model Project {
  id                              String     @id @default(cuid()) @db.VarChar(25)
  createdAt                       DateTime   @default(now()) @map("created_at")
  updatedAt                       DateTime   @updatedAt @map("updated_at")
  deletedAt                       DateTime?  @map("deleted_at")
  userId                          String     @map("user_id") @db.VarChar(25)
  user                            User       @relation(fields: [userId], references: [id])
  name                            String     @db.VarChar(255)
  documents                       Document[]
  faqs                            Faq[]
  knowledgeBaseIsUploading        Boolean    @default(false) @map("knowledge_base_is_uploading")
  knowledgeBaseLastUploadDateTime DateTime?  @map("knowledge_base_last_upload_date_time")
  chatCount                       Int        @default(0) @map("chat_count")

  @@map("projects")
}

model Document {
  id        String    @id @default(cuid()) @db.VarChar(25)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  projectId String    @map("project_id") @db.VarChar(25)
  project   Project   @relation(fields: [projectId], references: [id])
  title     String    @db.VarChar(255)
  content   String    @db.Text

  @@map("documents")
}

model Faq {
  id        String    @id @default(cuid()) @db.VarChar(25)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  projectId String    @map("project_id") @db.VarChar(25)
  project   Project   @relation(fields: [projectId], references: [id])
  question  String    @db.VarChar(255)
  answer    String    @db.Text

  @@map("faqs")
}
